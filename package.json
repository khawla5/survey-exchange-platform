{
  "name": "survey-exchange-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "predev": "docker compose up -d",
    "web": "npm run predev && concurrently -n BACKEND,FRONTEND -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "backend": "npm run dev -w backend",
    "frontend": "npm run dev -w frontend",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "npm run prisma:migrate -w backend",
    "db:studio": "npm run prisma:studio -w backend",
    "db:seed": "npm run prisma:seed -w backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
