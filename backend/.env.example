# --- App ---
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# --- Database ---
DATABASE_URL="postgresql://sep:sep_dev_password@localhost:5432/survey_exchange?schema=public"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- JWT ---
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_IN_REMEMBER=90d

# --- Cookies ---
COOKIE_SECRET=change_me_cookie_secret_min_32_chars_long

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- SMTP (leave empty in dev to auto-use an Ethereal sandbox inbox) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Survey Exchange <no-reply@surveyexchange.app>"

# --- AWS S3 (file uploads, phase 2+) ---
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# --- Points Economy ---
STARTER_POINTS=100
